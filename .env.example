# Copy to `.env` and fill in. The key is read server-side only (in /api/coach);
# it is never exposed to the browser bundle.
ANTHROPIC_API_KEY=sk-ant-...

# Optional: override the coach model (defaults to claude-sonnet-5).
# COACH_MODEL=claude-sonnet-5

# Optional: set false to disable public reference retrieval during pattern discovery.
# PATTERN_WEB_SEARCH=true
